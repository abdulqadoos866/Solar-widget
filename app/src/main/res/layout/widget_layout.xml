<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:padding="10dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SOLAR HOME" android:textStyle="bold" android:textSize="16sp" android:textColor="#17202A" android:layout_alignParentTop="true" android:layout_alignParentStart="true"/>
    <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CTNX-8kW • CT-16000" android:textSize="9sp" android:textColor="#7B838C" android:layout_below="@id/title" android:layout_alignParentStart="true"/>
    <TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE" android:textStyle="bold" android:textSize="9sp" android:textColor="#27874B" android:layout_alignParentTop="true" android:layout_alignParentEnd="true"/>

    <TextView android:id="@+id/pv" android:layout_width="92dp" android:layout_height="92dp" android:gravity="center" android:background="@drawable/node_pv" android:text="☀\n0.00 kW\nPV" android:textSize="11sp" android:textColor="#2B3035" android:layout_below="@id/subtitle" android:layout_alignParentStart="true" android:layout_marginTop="10dp"/>
    <TextView android:id="@+id/grid" android:layout_width="92dp" android:layout_height="92dp" android:gravity="center" android:background="@drawable/node_grid" android:text="⚡\n0.00 kW\nGrid" android:textSize="11sp" android:textColor="#2B3035" android:layout_below="@id/subtitle" android:layout_alignParentEnd="true" android:layout_marginTop="10dp"/>

    <TextView android:id="@+id/inverter" android:layout_width="88dp" android:layout_height="88dp" android:gravity="center" android:background="@drawable/inverter_node" android:text="INVERTER\n8 kW" android:textStyle="bold" android:textSize="11sp" android:textColor="#26384E" android:layout_centerHorizontal="true" android:layout_below="@id/subtitle" android:layout_marginTop="45dp"/>

    <TextView android:id="@+id/smart" android:layout_width="92dp" android:layout_height="92dp" android:gravity="center" android:background="@drawable/node_smart" android:text="AI\n0.80 kW\nSmart Load" android:textStyle="bold" android:textSize="10sp" android:textColor="#34304F" android:layout_below="@id/pv" android:layout_alignParentStart="true" android:layout_marginTop="18dp"/>
    <TextView android:id="@+id/battery" android:layout_width="92dp" android:layout_height="92dp" android:gravity="center" android:background="@drawable/node_battery" android:text="🔋\n68%\n1.36 kW" android:textStyle="bold" android:textSize="11sp" android:textColor="#34402F" android:layout_below="@id/pv" android:layout_alignParentEnd="true" android:layout_marginTop="18dp"/>
    <TextView android:id="@+id/backup" android:layout_width="92dp" android:layout_height="92dp" android:gravity="center" android:background="@drawable/node_load" android:text="🏠\n0.56 kW\nBackup" android:textStyle="bold" android:textSize="10sp" android:textColor="#314B7C" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:layout_marginBottom="18dp"/>

    <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Waiting for SolarCloud…" android:textSize="8sp" android:textColor="#7B838C" android:layout_alignParentBottom="true" android:layout_alignParentStart="true" android:layout_marginBottom="7dp"/>
</RelativeLayout>
